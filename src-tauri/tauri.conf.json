{
    "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
    "productName": "Collectyx",
    "identifier": "com.collectyx.app",
    "build": {
        "beforeDevCommand": "node src-tauri/scripts/clear-webview-cache.js",
        "frontendDist": "../src"
    },
    "app": {
        "withGlobalTauri": true,
        "windows": [
            {
                "title": "Collectyx",
                "width": 1500,
                "height": 1000,
                "resizable": true,
                "fullscreen": false
            }
        ],
        "security": {
            "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'"
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ],
        "android": {
            "debugApplicationIdSuffix": ".debug"
        }
    }
}
